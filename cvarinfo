// RS_Darkness -- CVars
//
// Darkness as a shader term rather than a per-sector rewrite.
//
// DarkDoomZ walks every sector and overwrites Sector.LightLevel, which means
// it holds a backup array to undo itself, destroys Lighting thinkers rather
// than fight them for the same field, and can only ever be uniform wall to
// wall inside one sector. This drives Level.SetDarkness instead: same four
// curves, same constants, evaluated against each fragment's own light. It
// writes nothing to the map, so there is nothing to undo and nothing to fight.

// ---------------------------------------------------------------- master --
server bool  rsd_enabled   = true;
server int   rsd_preset    = 4;          // Horizon -- distance, the thing a sector cannot do.
                                         // Must match RSD_Presets.DEFAULT.

// ----------------------------------------------------------------- curve --
// 0 off, 1 subtract, 2 compress, 3 cap brightest, 4 deepen shadows.
// Transcribed from DarkDoomZ, which took them from the original DarkDoom.
server int   rsd_mode      = 1;

// How hard, in Doom's 0-255 light units. 96/128/256 are Lite/Classic/Black.
server float rsd_adjust    = 128.0;

// Internal. What RS_Sweeps' darkness effect adds on top of rsd_adjust while a
// sweep is acting, in the same light units; 0 when no sweep is acting. The
// push adds it to the Amount and clamps the sum to 0-256.
// NOSAVE, NOT SERVER. RS_Sweeps used to move rsd_adjust itself: one server
// write per crossed sector per tic, each queued to the network, all reading
// the same not-yet-updated value, and the last one saved to the ini as the
// player's own Amount. This is local, immediate, and never the player's
// setting. It still persists in the ini like any nosave cvar, so the handler
// resets it to 0 whenever a map starts or a save is loaded.
nosave float rsd_sweep_offset = 0.0;

// A floor under the result. MUST be 0 for the Dark preset to reach true
// black -- any value here is light that survives everything.
server float rsd_minlight  = 0.0;

// Lifts before the curve / after it.
server float rsd_pregain   = 0.0;
server float rsd_postgain  = 0.0;

// ------------------------------------------------------------- distance --
// Darkness deepening with range from the eye. A sector cannot express this at
// all -- it is the term that makes a dark room read as having depth rather
// than as the brightness slider having gone down.
// depth 0 = off, 1 = fully black at range.
server float rsd_dist        = 0.0;
server float rsd_dist_range  = 1024.0;   // map units to reach full depth

// --------------------------------------------------------------- height --
// Dark pooling below a reference height, or rising as a tide. Above the
// reference nothing changes.
server float rsd_height       = 0.0;
server float rsd_height_range = 256.0;   // units below ref to reach full depth

// 0 fixed at rsd_height_z, 1 follows the player's feet.
server int   rsd_height_mode  = 0;
server float rsd_height_z     = 0.0;

// WHERE THE REFERENCE SITS RELATIVE TO YOU, in follow mode.
//
// The shader darkens only BELOW the reference. Following your feet therefore
// does almost nothing on flat ground -- the floor is at your feet, so it is
// not below them -- and the pool could only ever appear in geometry you were
// standing above. Undertow advertised wading to waist height and could not
// produce it.
//
// Offsetting the reference upward puts the top of the pool where the preset
// actually wants it: about 48 for waist, 64 for over your head. Negative
// values push it below you, so only what you climb down into goes dark.
server float rsd_height_offset = 0.0;

// The reference the shader actually gets is not a cvar. The push reads these
// three every tic and from UiTick, so the sliders move it while the menu is
// open. In follow mode the push hands the offset to the engine
// (Level.SetDarknessHeightFollow) and the renderer adds it to the camera's
// interpolated Z each frame, so the pool edge rides lifts and stairs smoothly
// and stays per-client: it is where YOUR view is, never the host.

// Internal. The preset index last applied, so a preset only re-applies when
// it CHANGES -- not on every map load, which used to wipe slider tweaks.
// NOSAVE, NOT SERVER. RS_GlowInTheDark's cvarinfo documents this failure at
// length: a server cvar is not written locally when you set it, so a latch
// read back on the next tic still reads its old value and the whole preset
// re-applies -- more cvar writes, which delays the round trip further, which
// causes more passes. GlowInTheDark compounded it until the tic's net buffer
// overflowed. This mod writes 12 to 19 cvars per apply rather than fifty-four
// so it has not hit that cliff, but it is the same defect.
//
// A savegame restores the server cvars but not this, so the handler keeps a
// copy with the save and puts the latch back to match on load.
nosave int   rsd_preset_applied = -1;

// HOW MUCH OF THE DARKNESS ACTORS ARE SPARED, 0 to 1.
//
// The darkening applies to the whole scene, which takes the monsters with it.
// At 0 a room dark enough to make the glow worth having is a room where a
// thing walking towards you simply is not there. 1 leaves actors at full
// brightness, which reads as cut out and pasted on.
//
// 0.4 keeps them readable as shapes without lifting them out of the room.
server float rsd_actor_spare = 0.4;
