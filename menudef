	StaticText ""
	StaticText "Picking a preset sets this: 0 for Blackout,", "gray"
	StaticText "0.40 for every other one. Tune it after.", "gray"
	StaticText ""
	StaticText "Fullbright frames - muzzle flashes, lit", "gray"
	StaticText "panels - are never darkened on either path.", "gray"
}

