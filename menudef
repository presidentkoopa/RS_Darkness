OptionMenu "RSDMain"
{
	Title "Darkness"
	StaticText "Evaluated per pixel in the shader, not by", "gray"
	StaticText "rewriting sector light. Nothing is written", "gray"
	StaticText "to the map, so nothing needs undoing.", "gray"
	StaticText ""
	Option "Enabled", "rsd_enabled", "OnOff"
	Option "Preset", "rsd_preset", "RSD_Preset"
	StaticText "A preset overwrites Curve, Distance and Height.", "gold"
	Command "Re-apply preset", "rsd_preset_applied -1"
	StaticText "Picking the same preset again changes nothing.", "gray"
	StaticText "This puts its values back after tuning.", "gray"
	StaticText ""
	StaticText "Light/Classic/Dark are DarkDoom's exactly.", "gray"
	StaticText "Everything below them uses distance or", "gray"
	StaticText "height - terms a sector cannot express.", "gray"
	StaticText ""
	Submenu "Curve", "RSDCurve"
	Submenu "Distance", "RSDDist"
	Submenu "Height", "RSDHeight"
	Submenu "Things In The Dark", "RSDActors"
}

OptionMenu "RSDCurve"
{
	Title "Curve"
	StaticText "The four DarkDoom curves, unchanged. What", "gray"
	StaticText "differs is the input: this pixel's own light", "gray"
	StaticText "rather than the whole room's.", "gray"
	StaticText ""
	Option "Curve", "rsd_mode", "RSD_Mode"
	StaticText "Off leaves each surface's light alone.", "gray"
	StaticText "Distance and Height still apply.", "gray"
	Slider "Amount", "rsd_adjust", 0, 256, 4, 0
	StaticText "96 = Light, 128 = Classic, 256 = total black", "gold"
	StaticText ""
	Slider "Minimum light", "rsd_minlight", 0, 255, 1, 0
	StaticText "Light that survives everything. Must be 0", "gold"
	StaticText "for Dark to reach true black.", "gold"
	StaticText ""
	Slider "Pre-gain (before curve)", "rsd_pregain", -128, 128, 2, 0
	Slider "Post-gain (after curve)", "rsd_postgain", -128, 128, 2, 0
}

OptionMenu "RSDDist"
{
	Title "Distance"
	StaticText "Darkness deepening with range from the eye.", "gray"
	StaticText "A sector cannot express this at all - it is", "gray"
	StaticText "what makes a dark room read as having depth", "gray"
	StaticText "instead of as a lowered brightness slider.", "gray"
	StaticText ""
	Slider "Depth", "rsd_dist", 0, 1, 0.05, 2
	Slider "Range (map units)", "rsd_dist_range", 64, 4096, 64, 0
}

OptionMenu "RSDHeight"
{
	Title "Height"
	StaticText "Dark pooling below a reference height.", "gray"
	StaticText "Above it, nothing changes.", "gray"
	StaticText ""
	Slider "Depth", "rsd_height", 0, 1, 0.05, 2
	Slider "Range below (map units)", "rsd_height_range", 32, 1024, 16, 0
	StaticText ""
	Option "Reference", "rsd_height_mode", "RSD_HeightMode"
	Slider "  Fixed height (Z)", "rsd_height_z", -2048, 2048, 32, 0
	StaticText ""
	Slider "  Offset from you", "rsd_height_offset", -256, 256, 8, 0
	StaticText "Follow mode only. The dark pools BELOW the", "gray"
	StaticText "reference, and your feet are already on the", "gray"
	StaticText "floor -- so with no offset, flat ground never", "gray"
	StaticText "darkens at all and only what you stand above", "gray"
	StaticText "does. Around 48 pools to your waist, 64 puts", "gray"
	StaticText "it over your head. Negative sinks it below", "gray"
	StaticText "you, so only what you climb down into goes", "gray"
	StaticText "dark.", "gray"
}

OptionMenu "RSDActors"
{
	Title "Things In The Dark"
	StaticText "The darkening applies to the whole scene, which", "gray"
	StaticText "takes the monsters with it. Fully dark is a room", "gray"
	StaticText "where the thing walking at you is not there at all;", "gray"
	StaticText "fully spared reads as cut out and pasted on.", "gray"
	StaticText ""
	Slider "Spare actors", "rsd_actor_spare", 0.0, 1.0, 0.05, 2
